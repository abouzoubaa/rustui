+        .position(|visible| {
+            anchor_center.x >= visible.origin.x
+                && anchor_center.x <= visible.origin.x + visible.size.width
+                && anchor_center.y >= visible.origin.y
+                && anchor_center.y <= visible.origin.y + visible.size.height
+        })
