+
+    struct RtlSelectHarness {
+        state: Entity<SelectState<SearchableVec<&'static str>>>,
+    }
+
+    impl Render for RtlSelectHarness {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .debug_selector(|| "rtl-select-trigger".to_owned())
+                .ml(px(240.))
+                .w(px(120.))
+                .child(
+                    Select::new(&self.state)
+                        .right_to_left(true)
+                        .menu_width(px(240.)),
+                )
+        }
+    }
+
+    #[gpui::test]
+    fn rtl_select_popup_aligns_to_the_trigger_end(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let (_, cx) = cx.add_window_view(|window, cx| {
+            let items = SearchableVec::new(vec!["A", "Long option"]);
+            let state = cx.new(|cx| SelectState::new(items, None, window, cx));
+            state.update(cx, |state, cx| state.set_open(true, cx));
+            RtlSelectHarness { state }
+        });
+        cx.simulate_resize(size(px(800.), px(600.)));
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        let trigger = cx.debug_bounds("rtl-select-trigger").unwrap();
+        let popup = cx.debug_bounds("rustui-select-popup-test").unwrap();
+        assert_eq!(popup.right(), trigger.right());
+    }
+
