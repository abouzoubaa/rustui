+fn next_enabled_menu_item(
+    menu_items: &[PopupMenuItem],
+    current: Option<usize>,
+    forward: bool,
+) -> Option<usize> {
+    let enabled = menu_items
+        .iter()
+        .enumerate()
+        .filter(|(_, item)| item.is_clickable());
+    if forward {
+        enabled
+            .clone()
+            .find(|(index, _)| current.is_none_or(|current| *index > current))
+            .map(|(index, _)| index)
+            .or_else(|| enabled.map(|(index, _)| index).next())
+    } else {
+        enabled
+            .clone()
+            .filter(|(index, _)| current.is_none_or(|current| *index < current))
+            .last()
+            .map(|(index, _)| index)
+            .or_else(|| enabled.map(|(index, _)| index).last())
+    }
+}
