+    pub fn test_fs2_drawable_sizes() -> Result<()> {
+        for (w, h) in [(3456, 2168), (5120, 2880), (6016, 3384)] {
+            objc2::rc::autoreleasepool(|_| -> Result<()> {
+                let mut renderer = MetalRenderer::new_headless(Default::default())?;
