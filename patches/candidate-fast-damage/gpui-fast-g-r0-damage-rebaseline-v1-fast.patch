diff --git a/crates/rustui-gpui-fast-apple/src/fast/damage/plan/cache.rs b/crates/rustui-gpui-fast-apple/src/fast/damage/plan/cache.rs
new file mode 100644
index 000000000..4a38aab09
--- /dev/null
+++ b/crates/rustui-gpui-fast-apple/src/fast/damage/plan/cache.rs
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+// RustUI memoization around the pinned longbridge/gpui-fast planner signatures.
+// Source: 2002081b4a61249a1cef2b8a552f6ba0998d9f52, crates/gpui_windows/src/fast/partial.rs.
+use super::Sig;
+#[derive(Default)]
+pub(crate) struct Cache {
+    previous: collections::HashMap<u64, Sig>,
+    next: collections::HashMap<u64, Sig>,
+    pub(crate) hashed: usize,
+    pub(crate) reused: usize,
+}
+impl Cache {
+    pub(crate) fn begin(&mut self) {
+        self.next.clear();
+        self.hashed = 0;
+        self.reused = 0;
+    }
+    pub(crate) fn finish(&mut self) {
+        std::mem::swap(&mut self.previous, &mut self.next);
+        self.next.clear();
+    }
+    pub(crate) fn clear(&mut self) {
+        self.previous.clear();
+        self.next.clear();
+        self.hashed = 0;
+        self.reused = 0;
+    }
+    pub(crate) fn replay(
+        &mut self,
+        source: Option<(u64, bool)>,
+        order: u32,
+        fresh: bool,
+    ) -> Option<Sig> {
+        let (id, true) = source? else { return None };
+        let mut signature = *self.previous.get(&id)?;
+        signature.order = order;
+        signature.fresh = fresh;
+        self.next.insert(id, signature);
+        self.reused += 1;
+        Some(signature)
+    }
+    pub(crate) fn push(&mut self, source: Option<(u64, bool)>, signature: Sig, out: &mut Vec<Sig>) {
+        self.hashed += 1;
+        if let Some((id, _)) = source {
+            self.next.insert(id, signature);
+        }
+        out.push(signature);
+    }
+}
diff --git a/crates/rustui-gpui-fast-apple/src/fast/damage/plan/fixed.rs b/crates/rustui-gpui-fast-apple/src/fast/damage/plan/fixed.rs
new file mode 100644
index 000000000..e50c1b00a
--- /dev/null
+++ b/crates/rustui-gpui-fast-apple/src/fast/damage/plan/fixed.rs
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+// RustUI: linear comparison for fixed-position updates before the pinned
+// Longbridge planner (2002081b4a61249a1cef2b8a552f6ba0998d9f52,
+// crates/gpui_windows/src/fast/partial.rs). Original RustUI optimization.
+use super::{Area, MAX_DAMAGE, Plan, Sig, tidy};
+
+// Positions, clips and orders must match exactly. Any movement or reordering
+// goes through the general multiset/scroll planner. Changed visual signatures
+// and fresh atlas tiles redraw their old and new reach in paint order.
+pub(super) fn plan(old: &[Sig], new: &[Sig], view: Area) -> Result<Option<Plan>, ()> {
+    if old.len() != new.len() {
+        return Err(());
+    }
+    let mut damage = Vec::new();
+    for (old, new) in old.iter().zip(new) {
+        if old.order != new.order || old.bounds != new.bounds || old.mask != new.mask {
+            return Err(());
+        }
+        if old.key != new.key || new.fresh {
+            damage.extend([old.reach, new.reach]);
+        }
+    }
+    let damage = tidy(damage, &view);
+    let total: f32 = damage.iter().map(Area::area).sum();
+    Ok((total <= MAX_DAMAGE * view.area()).then_some(Plan {
+        shift: None,
+        damage,
+    }))
+}
+
+#[cfg(any(test, feature = "test-support"))]
+pub(super) fn test_fixed() {
+    let view = Area {
+        x0: 0.,
+        y0: 0.,
+        x1: 1000.,
+        y1: 800.,
+    };
+    let bounds = Area {
+        x0: 10.,
+        y0: 10.,
+        x1: 20.,
+        y1: 20.,
+    };
+    let old = Sig {
+        key: 1,
+        order: 1,
+        bounds,
+        mask: view,
+        reach: bounds,
+        plain: false,
+        fresh: false,
+    };
+    for new in [
+        old,
+        Sig { key: 2, ..old },
+        Sig { fresh: true, ..old },
+        Sig {
+            key: 2,
+            reach: Area {
+                x0: 0.,
+                x1: 30.,
+                ..bounds
+            },
+            ..old
+        },
+    ] {
+        assert_eq!(
+            plan(&[old], &[new], view).unwrap(),
+            super::general_plan(&[old], &[new], view)
+        );
+    }
+    assert!(plan(&[old], &[], view).is_err());
+    assert!(plan(&[old], &[Sig { order: 2, ..old }], view).is_err());
+    assert!(
+        plan(
+            &[old],
+            &[Sig {
+                bounds: Area { y0: 11., ..bounds },
+                ..old
+            }],
+            view
+        )
+        .is_err()
+    );
+    assert!(
+        plan(
+            &[old],
+            &[Sig {
+                mask: bounds,
+                ..old
+            }],
+            view
+        )
+        .is_err()
+    );
+    assert_eq!(
+        plan(
+            &[Sig { reach: view, ..old }],
+            &[Sig {
+                key: 2,
+                reach: view,
+                ..old
+            }],
+            view
+        )
+        .unwrap(),
+        None
+    );
+}
