+            "RUSTUI_FRAME_LOG {{\"event\":\"damage_cpu\",\"cpu_ms\":0.0,\"signatures_ms\":{:.6},\"plan_ms\":{:.6},\"total_ms\":{total_ms:.6},\"hashed\":{},\"reused\":{},\"reason\":\"{}\",\"epoch_ms\":{epoch_ms:.6}}}",
+            self.signatures_ms, self.plan_ms, self.hashed, self.reused, self.reason
