+    fn handle_key_down(self: &Rc<Self>, event: JsValue) {
+        let event: web_sys::KeyboardEvent = event.unchecked_into();
+
+        let modifiers = modifiers_from_keyboard_event(&event, self.is_mac);
+        let capslock = capslock_from_keyboard_event(&event);
+
+        if self.update_modifiers(modifiers, capslock) {
+            self.dispatch_input(PlatformInput::ModifiersChanged(ModifiersChangedEvent {
+                modifiers,
+                capslock,
+            }));
+        }
+
+        let key = dom_key_to_gpui_key(&event);
+
+        if is_modifier_only_key(&key) {
+            return;
+        }
+
+        let is_held = event.repeat();
+        let key_char = compute_key_char(&event, &key, &modifiers);
+
+        // The software keyboard must edit the mirror itself: cancelling
+        // keydown prevents iOS from updating its autocorrect context and
+        // from delivering the corresponding beforeinput/input events.
+        if self.touch_input
+            && self.ime_mirror.virtual_keyboard_enabled()
+            && self.state.borrow().input_handler.is_some()
+            && !modifiers.platform
+            && !modifiers.control
+            && !modifiers.alt
+            && (key_char.is_some() || matches!(key.as_str(), "backspace" | "delete" | "enter"))
+        {
+            return;
+        }
+
+        let keystroke = Keystroke {
+            modifiers,
+            key,
+            key_char: key_char.clone(),
+        };
+
+        let result = self.dispatch_input(PlatformInput::KeyDown(KeyDownEvent {
+            keystroke,
+            is_held,
+            prefer_character_input: false,
+        }));
+
+        if let Some(result) = result {
+            if !result.propagate {
+                event.prevent_default();
+                self.schedule_ime_mirror_sync();
+                return;
+            }
+        }
+
+        if self.is_composing.get() || event.is_composing() {
+            event.prevent_default();
+            return;
+        }
+
+        if keystroke_inserts_text(&modifiers, self.is_mac)
+            && let Some(text) = key_char
+        {
+            self.with_input_handler(|handler| {
+                handler.replace_text_in_range(None, &text);
+            });
+            // The character went into the input handler; suppress browser
+            // side-effects for the same keystroke (space scrolling the
+            // page, quick-find, etc.). Everything not handled above falls
+            // through so browser shortcuts keep their defaults.
+            event.prevent_default();
+        }
+        self.schedule_ime_mirror_sync();
+    }
