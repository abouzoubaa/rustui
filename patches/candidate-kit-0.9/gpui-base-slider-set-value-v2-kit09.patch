+    /// Applies a numeric SetValue request from this slider's accessibility node.
+    #[doc(hidden)]
+    pub fn set_accessibility_value(
+        &mut self,
+        data: Option<&gpui::accesskit::ActionData>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(gpui::accesskit::ActionData::NumericValue(value)) = data else {
+            return;
+        };
+        let value = *value as f32;
+        if !value.is_finite() || !self.min.is_finite() || !self.max.is_finite() || self.min > self.max {
+            return;
+        }
+        let value = if value <= self.min {
+            self.min
+        } else if value >= self.max {
+            self.max
+        } else if is_step(self.step) {
+            (value / self.step).round() * self.step
+        } else {
+            value
+        };
+        let value = value.clamp(self.min, self.max);
+        let mut slider_value = self.value.clamp(self.min, self.max);
+        slider_value.set_end(value);
+        self.set_value(slider_value, window, cx);
+        cx.emit(SliderEvent::Change(slider_value));
+    }
