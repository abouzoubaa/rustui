new file mode 100644
index 000000000..88f9aa2fc
--- /dev/null
+++ b/vendor/gpui-fast-0.1.14/src/fast/motion_latch.rs
@@ -0,0 +1,220 @@
+// G5-4: motion is sampled before scene construction. Discrete events are barriers.
+use crate::{App, PlatformInput, ScrollDelta, ScrollSource, TouchPhase, Window, WindowId};
+use std::{
+    cell::{Cell, RefCell},
+    collections::{HashMap, HashSet},
+    sync::OnceLock,
+    time::{Duration, Instant},
+};
+
+use super::native_budget::Stamp;
+
+struct Pending {
+    event: PlatformInput,
+    stamp: Option<Stamp>,
+}
+
+thread_local! {
+    static PENDING: RefCell<HashMap<WindowId, Vec<Pending>>> = RefCell::new(HashMap::new());
+    static DEADLINES: RefCell<HashMap<WindowId, Instant>> = RefCell::new(HashMap::new());
+    static UNSUPPORTED: RefCell<HashSet<WindowId>> = RefCell::new(HashSet::new());
+    static NATIVE: Cell<bool> = const { Cell::new(false) };
+    static TARGET: Cell<Option<(f64, f64)>> = const { Cell::new(None) };
+}
+
+#[doc(hidden)]
+pub fn fast_g54_latest_enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    cfg!(target_os = "macos")
+        && *ON.get_or_init(|| std::env::var("RUSTUI_G5_LATCH_LATEST").as_deref() == Ok("1"))
+}
+
+fn deadline_requested() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RUSTUI_G5_LATCH_DEADLINE").as_deref() == Ok("1"))
+}
+
+#[doc(hidden)]
+pub struct G54NativeScope(bool);
+
+#[doc(hidden)]
+pub fn fast_g54_native_scope() -> G54NativeScope {
+    G54NativeScope(NATIVE.with(|active| active.replace(true)))
+}
+
+impl Drop for G54NativeScope {
+    fn drop(&mut self) {
+        NATIVE.with(|active| active.set(self.0));
+    }
+}
+
+pub(crate) fn accepts(event: &PlatformInput) -> bool {
+    fast_g54_latest_enabled() && NATIVE.with(Cell::get) && motion(event)
+}
+
+fn motion(event: &PlatformInput) -> bool {
+    matches!(event, PlatformInput::MouseMove(_))
+        || matches!(event, PlatformInput::Scroll(e) if e.source == ScrollSource::Pointer && e.touch_phase == TouchPhase::Moved)
+}
+
+fn same_direction(a: f32, b: f32) -> bool {
+    a == 0.0 || b == 0.0 || a.is_sign_positive() == b.is_sign_positive()
+}
+
+fn combine(old: &mut PlatformInput, new: &PlatformInput) -> bool {
+    match (old, new) {
+        (PlatformInput::MouseMove(old), PlatformInput::MouseMove(new))
+            if old.pressed_button == new.pressed_button && old.modifiers == new.modifiers =>
+        {
+            *old = new.clone();
+            true
+        }
+        (PlatformInput::Scroll(old), PlatformInput::Scroll(new))
+            if old.position == new.position && old.modifiers == new.modifiers =>
+        {
+            match (old.delta, new.delta) {
+                (ScrollDelta::Pixels(a), ScrollDelta::Pixels(b))
+                    if same_direction(a.x.into(), b.x.into())
+                        && same_direction(a.y.into(), b.y.into()) =>
+                {
+                    old.delta = ScrollDelta::Pixels(a + b);
+                    true
+                }
+                (ScrollDelta::Lines(a), ScrollDelta::Lines(b))
+                    if same_direction(a.x, b.x) && same_direction(a.y, b.y) =>
+                {
+                    old.delta = ScrollDelta::Lines(a + b);
+                    true
+                }
+                _ => false,
+            }
+        }
+        _ => false,
+    }
+}
+
+pub(crate) fn has_pending(id: WindowId) -> bool {
+    fast_g54_latest_enabled() && PENDING.with(|windows| windows.borrow().contains_key(&id))
+}
+
+pub(crate) fn enqueue(id: WindowId, event: PlatformInput, stamp: Option<Stamp>) {
+    PENDING.with(|windows| {
+        let mut windows = windows.borrow_mut();
+        let queue = windows.entry(id).or_default();
+        if let Some(last) = queue.last_mut()
+            && combine(&mut last.event, &event)
+        {
+            // AppKit can also send an untagged duplicate hover position.
+            // Keep the newest traceable sample when no newer stamp exists.
+            if stamp.is_some() {
+                last.stamp = stamp;
+            }
+        } else {
+            queue.push(Pending { event, stamp });
+        }
+    });
+}
+
+pub(crate) fn flush(window: &mut Window, cx: &mut App) {
+    if !fast_g54_latest_enabled() {
+        return;
+    }
+    let id = window.window_handle().window_id();
+    while let Some(queue) = PENDING.with(|windows| windows.borrow_mut().remove(&id)) {
+        for Pending { event, stamp } in queue {
+            window.dispatch_motion_sample(event, stamp, cx, false);
+        }
+    }
+}
+
+/// Maintain deadline scheduling only while a native pointer stream is active.
+#[doc(hidden)]
+pub fn fast_g54_deadline_input(id: WindowId, event: &PlatformInput, metal_link: bool) {
+    if !deadline_requested() {
+        return;
+    }
+    if !metal_link {
+        if motion(event) && UNSUPPORTED.with(|reported| reported.borrow_mut().insert(id)) {
+            eprintln!("RUSTUI_G54 {{\"event\":\"unsupported\"}}");
+        }
+        return;
+    }
+    if motion(event) {
+        DEADLINES.with(|windows| {
+            windows
+                .borrow_mut()
+                .insert(id, Instant::now() + Duration::from_millis(75));
+        });
+    } else if !matches!(event, PlatformInput::MouseExited(_)) {
+        DEADLINES.with(|windows| windows.borrow_mut().remove(&id));
+    }
+}
+
+#[doc(hidden)]
+pub fn fast_g54_deadline_active(id: WindowId) -> bool {
+    deadline_requested()
+        && DEADLINES.with(|windows| {
+            windows
+                .borrow()
+                .get(&id)
+                .is_some_and(|due| *due > Instant::now())
+        })
+}
+
+#[doc(hidden)]
+pub struct G54DeadlineScope(Option<(f64, f64)>);
+
+#[doc(hidden)]
+pub fn fast_g54_deadline_scope(target: f64, presentation: f64) -> G54DeadlineScope {
+    G54DeadlineScope(TARGET.with(|v| v.replace(Some((target, presentation)))))
+}
+impl Drop for G54DeadlineScope {
+    fn drop(&mut self) {
+        TARGET.with(|v| v.set(self.0));
+    }
+}
+#[doc(hidden)]
+pub fn fast_g54_deadline_target() -> Option<(f64, f64)> {
+    TARGET.with(Cell::get)
+}
+
+pub(crate) fn close(id: WindowId) {
+    if fast_g54_latest_enabled() {
+        PENDING.with(|w| w.borrow_mut().remove(&id));
+    }
+    if deadline_requested() {
+        DEADLINES.with(|w| w.borrow_mut().remove(&id));
+        UNSUPPORTED.with(|w| w.borrow_mut().remove(&id));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{MouseMoveEvent, ScrollEvent, point, px};
+
+    #[test]
+    fn latest_move_and_compatible_wheel_steps_preserve_end_state() {
+        let move_to = |x| {
+            PlatformInput::MouseMove(MouseMoveEvent {
+                position: point(px(x), px(5.0)),
+                ..Default::default()
+            })
+        };
+        let mut a = move_to(1.0);
+        assert!(combine(&mut a, &move_to(9.0)));
+        assert!(matches!(a, PlatformInput::MouseMove(m) if m.position.x == px(9.0)));
+        let wheel = |x| {
+            PlatformInput::Scroll(ScrollEvent {
+                delta: ScrollDelta::Pixels(point(px(0.0), px(x))),
+                ..Default::default()
+            })
+        };
+        let mut a = wheel(2.0);
+        assert!(combine(&mut a, &wheel(11.0)));
+        assert!(!combine(&mut a, &wheel(-5.0)));
+        assert!(
+            matches!(a, PlatformInput::Scroll(e) if matches!(e.delta, ScrollDelta::Pixels(p) if p.y == px(13.0)))
+        );
+    }
+}
diff --git a/vendor/gpui-fast-macos-0.1.14/src/fast/latch_deadline.rs b/vendor/gpui-fast-macos-0.1.14/src/fast/latch_deadline.rs
new file mode 100644
index 000000000..4d3e4b154
--- /dev/null
+++ b/vendor/gpui-fast-macos-0.1.14/src/fast/latch_deadline.rs
@@ -0,0 +1,102 @@
+// G5-4: share the existing CAMetalDisplayLink and hold at most one offered update.
+use super::{FrameSource, MacWindowState, metal_frame_ready};
+use objc2::rc::Retained;
+use objc2_quartz_core::CAMetalDisplayLinkUpdate;
+use parking_lot::Mutex;
+use std::{cell::RefCell, collections::HashSet, rc::Rc, sync::OnceLock, time::Duration};
+
+#[link(name = "QuartzCore", kind = "framework")]
+unsafe extern "C-unwind" {
+    fn CACurrentMediaTime() -> f64;
+}
+
+thread_local! {
+    static WAITING: RefCell<HashSet<gpui::WindowId>> = RefCell::new(HashSet::new());
+}
+
+fn host_now() -> f64 {
+    unsafe { CACurrentMediaTime() }
+}
+fn budget() -> f64 {
+    static P95: OnceLock<f64> = OnceLock::new();
+    *P95.get_or_init(|| {
+        std::env::var("RUSTUI_G54_P95_MS")
+            .ok()
+            .and_then(|s| s.parse::<f64>().ok())
+            .filter(|ms| ms.is_finite() && (0.1..=100.0).contains(ms))
+            .unwrap_or(5.0)
+            / 1000.0
+    })
+}
+
+fn miss(id: gpui::WindowId, target: f64, cutoff: f64, now: f64, phase: u8) {
+    if gpui::fast_latency_enabled() {
+        gpui::fast_latency_config(
+            id,
+            "g54_deadline_missed",
+            [f64::from(phase), target, cutoff, now],
+        );
+    } else {
+        eprintln!(
+            "RUSTUI_G54 deadline_missed phase={phase} target={target:.9} cutoff={cutoff:.9} actual={now:.9}"
+        );
+    }
+}
+
+pub(super) fn defer(state: &Rc<Mutex<MacWindowState>>, update: &CAMetalDisplayLinkUpdate) -> bool {
+    let lock = state.lock();
+    let id = lock.handle.window_id();
+    if !gpui::fast_g54_deadline_active(id) || !lock.renderer.immediate_allowed() {
+        return false;
+    }
+    let FrameSource::Metal(source) = &lock.frame_source else {
+        return false;
+    };
+    let generation = source.g54_generation();
+    let source = Rc::downgrade(source);
+    let target = update.targetTimestamp();
+    let presentation = update.targetPresentationTimestamp();
+    let cutoff = target - budget() - 0.001;
+    let now = host_now();
+    if !target.is_finite() || now > cutoff {
+        if target.is_finite() {
+            miss(id, target, cutoff, now, 1);
+        }
+        return true;
+    }
+    if !WAITING.with(|w| w.borrow_mut().insert(id)) {
+        return true;
+    }
+    let weak = Rc::downgrade(state);
+    let background = lock.background_executor.clone();
+    let update = unsafe { Retained::retain(std::ptr::from_ref(update).cast_mut()) }
+        .expect("display link update is present");
+    lock.foreground_executor.spawn(async move {
+        // Leave half a millisecond for foreground timer delivery.
+        let wait = (cutoff - host_now() - 0.0005).max(0.0);
+        if wait > 0.0 {
+            background.timer(Duration::from_secs_f64(wait)).await;
+        }
+        WAITING.with(|w| w.borrow_mut().remove(&id));
+        let Some(state) = weak.upgrade() else { return };
+        if !gpui::fast_g54_deadline_active(id) {
+            return;
+        }
+        if !source.upgrade().is_some_and(|source| {
+            let lock = state.lock();
+            matches!(&lock.frame_source, FrameSource::Metal(current) if Rc::ptr_eq(current, &source) && source.is_attached() && source.g54_generation() == generation)
+                && lock.renderer.immediate_allowed()
+        }) {
+            return;
+        }
+        let now = host_now();
+        if now > cutoff {
+            miss(id, target, cutoff, now, 2);
+            return;
+        }
+        gpui::fast_latency_config(id, "g54_deadline_started", [target, cutoff, now, presentation]);
+        let _target = gpui::fast_g54_deadline_scope(target, presentation);
+        metal_frame_ready(&state, &update);
+    }).detach();
+    true
+}
