--- /dev/null
+++ b/vendor/gpui-fast-macos-0.1.14/src/fast/latch_queue.rs
@@ -0,0 +1,64 @@
+// G5-4: deliver the pending Cocoa motion prefix in order before the post-event wake.
+use objc2_app_kit::{NSApplication, NSEvent, NSEventMask, NSEventType};
+use objc2_foundation::{NSDate, NSDefaultRunLoopMode, NSRunLoop};
+use std::cell::Cell;
+
+#[link(name = "QuartzCore", kind = "framework")]
+unsafe extern "C-unwind" {
+    fn CACurrentMediaTime() -> f64;
+}
+
+thread_local! {
+    static DRAINING: Cell<bool> = const { Cell::new(false) };
+}
+
+fn is_motion(event: &NSEvent) -> bool {
+    matches!(
+        event.r#type(),
+        NSEventType::MouseMoved
+            | NSEventType::LeftMouseDragged
+            | NSEventType::RightMouseDragged
+            | NSEventType::OtherMouseDragged
+            | NSEventType::ScrollWheel
+    )
+}
+
+pub(super) fn drain(app: &NSApplication, current: &NSEvent) {
+    if !is_motion(current) || current.windowNumber() == 0 {
+        return;
+    }
+    DRAINING.with(|draining| {
+        if draining.replace(true) {
+            return;
+        }
+        let mode = NSRunLoop::currentRunLoop().currentMode();
+        let mode = mode.as_deref().unwrap_or(unsafe { NSDefaultRunLoopMode });
+        let now = NSDate::distantPast();
+        // Bound the drain to the queue present when it starts. Pointer events
+        // posted while flushing belong to the next input turn.
+        let cutoff = unsafe { CACurrentMediaTime() };
+        while let Some(head) = app.nextEventMatchingMask_untilDate_inMode_dequeue(
+            NSEventMask::Any,
+            Some(&now),
+            mode,
+            false,
+        ) {
+            if head.windowNumber() != current.windowNumber()
+                || head.timestamp() > cutoff
+                || !is_motion(&head)
+            {
+                break;
+            }
+            let Some(head) = app.nextEventMatchingMask_untilDate_inMode_dequeue(
+                NSEventMask::Any,
+                Some(&now),
+                mode,
+                true,
+            ) else {
+                break;
+            };
+            app.sendEvent(&head);
+        }
+        draining.set(false);
+    });
+}
