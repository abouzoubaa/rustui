+pub(crate) fn g54_deadline_committed() {
+    let Some((submit, _)) = gpui::fast_g54_deadline_target() else {
+        return;
+    };
+    let now = unsafe { CACurrentMediaTime() };
+    if now > submit {
+        if let Some(frame) = gpui::fast_latency_frame() {
+            gpui::fast_latency_config(
+                frame.window(),
+                "g54_deadline_missed",
+                [3., submit, submit, now],
+            );
+        } else {
+            eprintln!("RUSTUI_G54 deadline_missed phase=3 target={submit:.9} actual={now:.9}");
+        }
+    }
+}
