+    let latch = gpui::fast_g54_latest_enabled();
+    let _motion = latch.then(gpui::fast_g54_native_scope);
     unsafe {
         let _: () = msg_send![super(this, class!(NSApplication)), sendEvent: event];
+        if latch && let Some(event) = event.cast::<objc2_app_kit::NSEvent>().as_ref() {
