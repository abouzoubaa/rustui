+    /// Handles value actions registered on this slider's accessibility node.
+    pub fn handle_accessibility_action(
+        &mut self,
+        action: AccessibleAction,
+        data: Option<&gpui::accesskit::ActionData>,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let value = match action {
+            AccessibleAction::SetValue => {
+                let Some(gpui::accesskit::ActionData::NumericValue(value)) = data else {
+                    return;
+                };
+                *value as f32
+            }
+            AccessibleAction::Increment => self.value.end() + self.step,
+            AccessibleAction::Decrement => self.value.end() - self.step,
+            _ => return,
+        };
+        if !value.is_finite() {
+            return;
+        }
+        let value = value.clamp(self.min, self.max);
+        let value = if value == self.min || value == self.max {
+            value
+        } else if self.step.is_finite() && self.step > 0.0 {
+            ((value / self.step).round() * self.step).clamp(self.min, self.max)
+        } else {
+            value
+        };
+        let mut slider_value = self.value.clamp(self.min, self.max);
+        slider_value.set_end(value);
+        self.value = slider_value;
+        self.update_thumb_pos();
+        cx.emit(SliderEvent::Change(self.value));
+        cx.notify();
+    }
+
     /// Get the value of the slider.
