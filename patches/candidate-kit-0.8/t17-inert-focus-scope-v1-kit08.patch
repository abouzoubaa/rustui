+    fn has_rendered_inert_focus_scope(&self) -> bool {
+        self.inert_focus_scopes.iter().any(|scope| {
+            scope.upgrade().is_some_and(|scope| {
+                self.rendered_frame
+                    .dispatch_tree
+                    .focusable_node_id(scope.id)
+                    .is_some()
+            })
+        })
+    }
