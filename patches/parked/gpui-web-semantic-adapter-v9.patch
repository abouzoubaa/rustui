+impl Drop for Adapter {
+    fn drop(&mut self) {
+        self.state.borrow_mut().healthy = false;
+        self.dom.close();
+        let callbacks = self.state.borrow().callbacks.clone();
+        (callbacks.deactivation)();
+    }
