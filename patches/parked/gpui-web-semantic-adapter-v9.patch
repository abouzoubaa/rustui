+        put(&descriptor, "id", id.0.to_string());
+        put(&descriptor, "kind", kind);
+        put(&descriptor, "attrs", attrs);
+        put(&descriptor, "disabled", is_disabled);
+        put(&descriptor, "readOnly", node.is_read_only());
