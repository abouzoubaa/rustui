[package]
name = "gpui-pre-collections"
version = "0.3.12"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Standard collection types used by Zed and GPUI (gpui-pre snapshot of zed@d2a4fb6)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "collections"
zed-version = "0.1.0"
zed-rev = "d2a4fb6ded7c470be25d1541281da3882495b65b"

[lib]
path = "src/collections.rs"
doctest = false
name = "collections"

[features]
test-support = []

[dependencies]
indexmap = { workspace = true }
rustc-hash = { workspace = true }
gpui_util = { workspace = true }

[lints]
workspace = true
