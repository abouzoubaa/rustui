+#[cfg(test)]
+mod quad_order_tests {
+    use super::*;
+    use crate::{ScaledPixels, hsla, size};
+
+    fn quad(order: DrawOrder, index: usize) -> Quad {
+        let p = ScaledPixels(index as f32);
+        Quad {
+            order,
+            border_style: if index % 2 == 0 {
+                BorderStyle::Solid
+            } else {
+                BorderStyle::Dashed
+            },
+            bounds: Bounds {
+                origin: point(p, ScaledPixels(p.0 + 1.0)),
+                size: size(ScaledPixels(p.0 + 2.0), ScaledPixels(p.0 + 3.0)),
+            },
+            content_mask: ContentMask {
+                bounds: Bounds {
+                    origin: point(ScaledPixels(p.0 + 4.0), ScaledPixels(p.0 + 5.0)),
+                    size: size(ScaledPixels(p.0 + 6.0), ScaledPixels(p.0 + 7.0)),
+                },
+            },
+            background: hsla((index % 10) as f32 / 10.0, 0.4, 0.5, 0.6).into(),
+            border_color: hsla(0.1, (index % 10) as f32 / 10.0, 0.3, 0.7),
+            corner_radii: Corners {
+                top_left: p,
+                top_right: ScaledPixels(p.0 + 1.0),
+                bottom_left: ScaledPixels(p.0 + 2.0),
+                bottom_right: ScaledPixels(p.0 + 3.0),
+            },
+            border_widths: Edges {
+                top: p,
+                right: ScaledPixels(p.0 + 1.0),
+                bottom: ScaledPixels(p.0 + 2.0),
+                left: ScaledPixels(p.0 + 3.0),
+            },
+        }
+    }
+
+    fn assert_same_quad(actual: &Quad, expected: &Quad) {
+        assert_eq!(actual.order, expected.order);
+        assert_eq!(actual.border_style, expected.border_style);
+        assert_eq!(actual.bounds, expected.bounds);
+        assert_eq!(actual.content_mask, expected.content_mask);
+        assert_eq!(actual.background, expected.background);
+        assert_eq!(actual.border_color, expected.border_color);
+        assert_eq!(actual.corner_radii, expected.corner_radii);
+        assert_eq!(actual.border_widths, expected.border_widths);
+    }
+
+    fn compare(orders: &[u32], budget: usize, scratch: &mut QuadOrderScratch) -> QuadOrderPath {
+        let mut actual: Vec<_> = orders
+            .iter()
+            .enumerate()
+            .map(|(i, &order)| quad(order, i))
+            .collect();
+        let mut expected = actual.clone();
+        expected.sort_by_key(|quad| quad.order);
+        let path = sort_quads_by_order(&mut actual, scratch, budget);
+        assert_eq!(actual.len(), expected.len());
+        for (actual, expected) in actual.iter().zip(&expected) {
+            assert_same_quad(actual, expected);
+        }
+        assert!(scratch.capacity_bytes().unwrap() <= budget);
+        path
+    }
+
+    #[test]
+    fn dense_counting_matches_stable_sort_and_preserves_all_payload_fields() {
+        let mut scratch = QuadOrderScratch::default();
+        for orders in [
+            vec![],
+            vec![4],
+            vec![1, 1, 2],
+            vec![2, 0, 1],
+            vec![2, 1, 2, 0, 1, 0],
+            vec![3, 2, 1, 0],
+        ] {
+            compare(&orders, QUAD_ORDER_SCRATCH_BYTES, &mut scratch);
+        }
+        assert_eq!(
+            compare(&[2, 1, 0, 2, 1], QUAD_ORDER_SCRATCH_BYTES, &mut scratch),
+            QuadOrderPath::Counting
+        );
+    }
+
+    #[test]
+    fn deterministic_generated_inputs_match_stable_sort() {
+        let mut scratch = QuadOrderScratch::default();
+        for seed in 0..32_u64 {
+            let mut rng = seed + 1;
+            for len in [2, 3, 16, 257, 1024] {
+                let orders: Vec<_> = (0..len)
+                    .map(|_| {
+                        rng = rng.wrapping_mul(6364136223846793005).wrapping_add(1);
+                        (rng >> 32) as u32 % (len as u32 / 2 + 1)
+                    })
+                    .collect();
+                compare(&orders, QUAD_ORDER_SCRATCH_BYTES, &mut scratch);
+            }
+        }
+    }
+
+    #[test]
+    fn sparse_maximum_and_memory_paths_fall_back_without_retained_scratch() {
+        let mut scratch = QuadOrderScratch::default();
+        for (orders, budget) in [
+            (vec![u32::MAX, 0, u32::MAX], QUAD_ORDER_SCRATCH_BYTES),
+            (vec![1000, 0], QUAD_ORDER_SCRATCH_BYTES),
+            (vec![1, 0], 0),
+        ] {
+            assert_eq!(compare(&orders, budget, &mut scratch), QuadOrderPath::Stock);
+            assert_eq!(scratch.capacity_bytes(), Some(0));
+        }
+    }
+
+    #[test]
+    fn budget_and_bin_planning_are_checked_before_allocation() {
+        let needed = (4 + 4) * std::mem::size_of::<usize>();
+        assert_eq!(quad_order_bins(4, 3, needed), Some(4));
+        assert_eq!(quad_order_bins(4, 3, needed - 1), None);
+        assert_eq!(quad_order_bins(usize::MAX, 2, usize::MAX), None);
+        assert_eq!(quad_order_bins(2, u32::MAX, usize::MAX), None);
+        assert_eq!(
+            quad_order_bins(QUAD_ORDER_MAX_BINS, QUAD_ORDER_MAX_BINS as u32, usize::MAX),
+            None
+        );
+        assert_eq!(
+            quad_order_bins(
+                QUAD_ORDER_MAX_BINS,
+                (QUAD_ORDER_MAX_BINS - 1) as u32,
+                QUAD_ORDER_SCRATCH_BYTES
+            ),
+            Some(QUAD_ORDER_MAX_BINS)
+        );
+    }
+
+    #[test]
+    fn scene_clear_and_size_changes_do_not_reuse_stale_permutations() {
+        let mut scene = Scene::default();
+        for len in [1024, 3, 0, 512, 1, 17] {
+            scene.clear();
+            scene.quads = (0..len).map(|i| quad(((len - i) % 8) as u32, i)).collect();
+            let mut expected = scene.quads.clone();
+            expected.sort_by_key(|quad| quad.order);
+            scene.finish();
+            for (actual, expected) in scene.quads.iter().zip(&expected) {
+                assert_same_quad(actual, expected);
+            }
+            assert!(scene.quad_order_scratch.capacity_bytes().unwrap() <= QUAD_ORDER_SCRATCH_BYTES);
+        }
+    }
+
+    #[test]
+    fn alternating_scratch_high_water_marks_remain_within_budget() {
+        let mut scratch = QuadOrderScratch::default();
+        compare(&[3, 1, 2, 0], QUAD_ORDER_SCRATCH_BYTES, &mut scratch);
+        let small = 8 * std::mem::size_of::<usize>();
+        compare(&[1, 0], small, &mut scratch);
+        assert!(scratch.capacity_bytes().unwrap() <= small);
+        compare(&[1, 0], 0, &mut scratch);
+        assert_eq!(scratch.capacity_bytes(), Some(0));
+    }
+
+    #[test]
+    fn nonfinite_and_signed_zero_payloads_are_swapped_without_arithmetic() {
+        let mut actual = vec![quad(1, 0), quad(0, 1)];
+        actual[0].border_color.h = f32::from_bits(0x7fc0_1234);
+        actual[0].border_widths.top = ScaledPixels(-0.0);
+        let mut scratch = QuadOrderScratch::default();
+        sort_quads_by_order(&mut actual, &mut scratch, QUAD_ORDER_SCRATCH_BYTES);
+        assert_eq!(actual[1].border_color.h.to_bits(), 0x7fc0_1234);
+        assert_eq!(
+            actual[1].border_widths.top.0.to_bits(),
+            (-0.0_f32).to_bits()
+        );
+    }
+}
