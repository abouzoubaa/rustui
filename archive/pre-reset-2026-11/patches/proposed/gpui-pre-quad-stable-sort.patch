+// Quad-only adaptation of the stable counting-order idea reviewed in
+// longbridge/gpui-fast@fa133a1dd970532dce4ffaee8577438971e5dec9,
+// crates/gpui/src/fast/scene.rs (Apache-2.0). Uses in-place permutation
+// cycles rather than copying/gathering every primitive kind.
+const QUAD_ORDER_SCRATCH_BYTES: usize = 1024 * 1024;
+const QUAD_ORDER_MAX_BINS: usize = 65536;
+
+#[derive(Default)]
+struct QuadOrderScratch {
+    counts: Vec<usize>,
+    destinations: Vec<usize>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum QuadOrderPath {
+    AlreadyOrdered,
+    Counting,
+    Stock,
+}
+
+fn quad_order_bins(len: usize, max_order: DrawOrder, budget: usize) -> Option<usize> {
+    let bins = usize::try_from(max_order).ok()?.checked_add(1)?;
+    if bins > QUAD_ORDER_MAX_BINS || bins > len.checked_mul(4)? {
+        return None;
+    }
+    let bytes = bins
+        .checked_add(len)?
+        .checked_mul(std::mem::size_of::<usize>())?;
+    (bytes <= budget).then_some(bins)
+}
+
+impl QuadOrderScratch {
+    fn release(&mut self) {
+        *self = Self::default();
+    }
+
+    fn capacity_bytes(&self) -> Option<usize> {
+        self.counts
+            .capacity()
+            .checked_add(self.destinations.capacity())?
+            .checked_mul(std::mem::size_of::<usize>())
+    }
+
+    fn prepare(&mut self, len: usize, bins: usize, budget: usize) -> bool {
+        // Never retain two independently grown high-water marks over budget.
+        // Drop both before growing; failed reservations take the stock path.
+        if self.counts.capacity() < bins || self.destinations.capacity() < len {
+            self.release();
+            if self.counts.try_reserve_exact(bins).is_err()
+                || self.destinations.try_reserve_exact(len).is_err()
+            {
+                self.release();
+                return false;
+            }
+        }
+        // Vec/allocator may grant more capacity than requested. Bound the
+        // actual retained element capacities too, not just requested lengths.
+        if self.capacity_bytes().is_none_or(|bytes| bytes > budget) {
+            self.release();
+            return false;
+        }
+        self.counts.clear();
+        self.counts.resize(bins, 0);
+        self.destinations.clear();
+        self.destinations.resize(len, 0);
+        true
+    }
+}
+
+fn sort_quads_by_order(
+    quads: &mut [Quad],
+    scratch: &mut QuadOrderScratch,
+    budget: usize,
+) -> QuadOrderPath {
+    if scratch.capacity_bytes().is_none_or(|bytes| bytes > budget) {
+        scratch.release();
+    }
+    let mut max_order = 0;
+    let mut previous = 0;
+    let mut ordered = true;
+    for quad in quads.iter() {
+        ordered &= quad.order >= previous;
+        previous = quad.order;
+        max_order = max_order.max(quad.order);
+    }
+    if ordered {
+        return QuadOrderPath::AlreadyOrdered;
+    }
+    let Some(bins) = quad_order_bins(quads.len(), max_order, budget) else {
+        scratch.release();
+        quads.sort_by_key(|quad| quad.order);
+        return QuadOrderPath::Stock;
+    };
+    if !scratch.prepare(quads.len(), bins, budget) {
+        quads.sort_by_key(|quad| quad.order);
+        return QuadOrderPath::Stock;
+    }
+    // max_order was checked to fit usize above; every order is <= max_order.
+    for quad in quads.iter() {
+        scratch.counts[quad.order as usize] += 1;
+    }
+    let mut start = 0;
+    for count in &mut scratch.counts {
+        let amount = *count;
+        *count = start;
+        start += amount;
+    }
+    // Assign unique final positions in input order: ties keep that order.
+    for (index, quad) in quads.iter().enumerate() {
+        let destination = &mut scratch.counts[quad.order as usize];
+        scratch.destinations[index] = *destination;
+        *destination += 1;
+    }
+    // Move complete Quad values only; never reconstruct or mutate payloads.
+    for index in 0..quads.len() {
+        while scratch.destinations[index] != index {
+            let destination = scratch.destinations[index];
+            quads.swap(index, destination);
+            scratch.destinations.swap(index, destination);
+        }
+    }
+    QuadOrderPath::Counting
+}
