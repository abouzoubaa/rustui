#!/bin/sh
set -eu

headstart_root="${RUSTUI_HEADSTART_ROOT:-${HOME}/.local/opt/headstart}"
cargo_bin="${headstart_root}/cargo/target/release/cargo"
rustc_host="$(rustc -vV | sed -n 's/^host: //p')"
rustc_bin="${headstart_root}/rustc/build/${rustc_host}/stage1/bin/rustc"
rustdoc_bin="${headstart_root}/rustc/build/${rustc_host}/stage1/bin/rustdoc"

if [ ! -x "$cargo_bin" ]; then
    printf '%s\n' "Headstart Cargo is missing under ${headstart_root}." >&2
    exit 127
fi

# Preserve explicit compiler selection for target-specific builds. Otherwise
# use the installed Headstart stage1 compiler as before.
if [ "${RUSTC+x}" != x ]; then
    if [ ! -x "$rustc_bin" ]; then
        printf '%s\n' "Headstart rustc is missing under ${headstart_root}." >&2
        exit 127
    fi
    RUSTC="$rustc_bin"
elif ! command -v "$RUSTC" >/dev/null 2>&1; then
    printf '%s\n' "The explicit RUSTC compiler is not executable: ${RUSTC}." >&2
    exit 127
fi

# Use rustdoc from the same Headstart stage as rustc when it is installed.
# Otherwise Cargo keeps its normal rustdoc resolution; an explicit caller
# RUSTDOC always takes precedence.
if [ "${RUSTDOC+x}" != x ] && [ -x "$rustdoc_bin" ]; then
    RUSTDOC="$rustdoc_bin"
    export RUSTDOC
elif [ "${RUSTDOC+x}" != x ] && [ "$RUSTC" = "$rustc_bin" ] &&
     [ -x "${headstart_root}/rustc/build/${rustc_host}/stage1-tools-bin/rustdoc-tool-binary" ]; then
    # The bootstrap tree can install rustdoc as a tool rather than stage1/bin.
    # Use a subprocess wrapper because Cargo rewrites dynamic-library paths.
    RUSTDOC="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/rustdoc-headstart"
    export RUSTDOC
fi

# Keep candidate snapshots from sharing the accepted workspace cache. Candidate
# workspaces live below target/headstart/candidates/<id>; their ID is therefore
# available from the physical working directory, including copied wrappers.
working_dir="$(pwd -P)"
case "$working_dir" in
    */target/headstart/candidates/*)
        candidate_prefix="${working_dir%%/target/headstart/candidates/*}"
        candidate_suffix="${working_dir#"${candidate_prefix}/target/headstart/candidates/"}"
        candidate_id="${candidate_suffix%%/*}"
        case "$candidate_id" in
            ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*|*..* )
                printf '%s\n' "Invalid candidate workspace ID: ${candidate_id}" >&2
                exit 2
                ;;
            * ) ;;
        esac
        if [ "${#candidate_id}" -gt 64 ]; then
            printf '%s\n' "Invalid candidate workspace ID: ${candidate_id}" >&2
            exit 2
        fi
        candidate_root="${candidate_prefix}/target/headstart/candidates/${candidate_id}"
        candidate_root="$(CDPATH= cd -- "$candidate_root" && pwd -P)"
        if [ -z "${CARGO_TARGET_DIR:-}" ]; then
            CARGO_TARGET_DIR="${candidate_root}/target"
        else
            # Permit explicit candidate-local targets (for example paired
            # baseline/candidate caches), but reject paths outside this ID.
            # A dangling final symlink would otherwise pass the lexical check
            # below and let Cargo create its target outside this candidate.
            if [ -L "$CARGO_TARGET_DIR" ] && [ ! -d "$CARGO_TARGET_DIR" ]; then
                printf '%s\n' "Candidate CARGO_TARGET_DIR cannot be a dangling or non-directory symlink: ${CARGO_TARGET_DIR}." >&2
                exit 2
            elif [ -d "$CARGO_TARGET_DIR" ]; then
                resolved_target_dir="$(CDPATH= cd -- "$CARGO_TARGET_DIR" && pwd -P)"
            else
                target_parent="$(dirname -- "$CARGO_TARGET_DIR")"
                target_leaf="$(basename -- "$CARGO_TARGET_DIR")"
                resolved_target_dir="$(CDPATH= cd -- "$target_parent" && pwd -P)/${target_leaf}"
            fi
            case "$resolved_target_dir" in
                "$candidate_root"|"${candidate_root}"/*) ;;
                *) printf '%s\n' "Candidate builds require CARGO_TARGET_DIR inside ${candidate_root}; refusing ${CARGO_TARGET_DIR}." >&2; exit 2 ;;
            esac
        fi
        export CARGO_TARGET_DIR
        ;;
    *)
        # Normal workspace default remains unchanged.
        if [ -z "${CARGO_TARGET_DIR:-}" ]; then
            rustui_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
            CARGO_TARGET_DIR="${rustui_root}/target/headstart"
            export CARGO_TARGET_DIR
        fi
        ;;
esac

# Workaround for Headstart's early/full metadata SVH mismatch. These flags are
# visible to Cargo so they participate in artifact fingerprints.
metadata_flag="-Zmetadata-crate-hash=no"
if [ "${CARGO_ENCODED_RUSTFLAGS+x}" = x ]; then
    separator="$(printf '\037')"
    CARGO_ENCODED_RUSTFLAGS="${CARGO_ENCODED_RUSTFLAGS:+${CARGO_ENCODED_RUSTFLAGS}${separator}}${metadata_flag}"
    export CARGO_ENCODED_RUSTFLAGS
elif [ "${RUSTFLAGS+x}" = x ]; then
    RUSTFLAGS="${RUSTFLAGS:+${RUSTFLAGS} }${metadata_flag}"
    export RUSTFLAGS
else
    set -- --config 'build.rustflags=["-Zmetadata-crate-hash=no"]' "$@"
fi

exec env RUSTC="$RUSTC" "$cargo_bin" -Zheadstart "$@"
