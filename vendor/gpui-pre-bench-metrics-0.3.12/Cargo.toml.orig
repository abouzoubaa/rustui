[package]
name = "gpui-pre-bench-metrics"
version = "0.3.12"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `bench_metrics` crate (gpui-pre snapshot of zed@d2a4fb6)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "bench_metrics"
zed-version = "0.1.0"
zed-rev = "d2a4fb6ded7c470be25d1541281da3882495b65b"

[lib]
path = "src/bench_metrics.rs"
doctest = false
name = "bench_metrics"

[features]
test-support = []

[dependencies]
anyhow = { workspace = true }
criterion = { workspace = true }

[target.'cfg(unix)'.dependencies]
libc = { workspace = true }

[target.'cfg(target_os = "linux")'.dependencies]
perf-event = { workspace = true }

[lints]
workspace = true
