[package]
name = "gpui-pre-http-client"
version = "0.3.12"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "A HTTP client library for Zed and GPUI (gpui-pre snapshot of zed@d2a4fb6)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "http_client"
zed-version = "0.1.0"
zed-rev = "d2a4fb6ded7c470be25d1541281da3882495b65b"

[lib]
path = "src/http_client.rs"
test = false
doctest = false
name = "http_client"

[features]
test-support = ["dep:log"]

[dependencies]
anyhow = { workspace = true }
bytes = { workspace = true }
futures = { workspace = true }
http-body = { workspace = true }
http = { workspace = true }
log = { workspace = true, optional = true }
parking_lot = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
serde_urlencoded = { workspace = true }
url = { workspace = true }

[lints]
workspace = true
